<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Microphone access for dictation and meeting recording -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Accessibility: required by rdev (global key capture) and enigo (keyboard simulation) -->
    <key>com.apple.security.accessibility</key>
    <true/>

    <!-- Input Monitoring: required by rdev to listen to global key events -->
    <key>com.apple.security.input-monitoring</key>
    <true/>

    <!-- Screen Recording: required by ScreenCaptureKit for system audio capture in meeting mode -->
    <key>com.apple.security.screen-recording</key>
    <true/>

    <!-- Hardened runtime: allow loading of unsigned dynamic libraries (ONNX runtime, Whisper, Parakeet) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
